{
    "name": "fb-cookie-checker",
    "version": "1.0.0",
    "description": "Facebook Cookie Checker Tool",
    "main": "main.js",
    "scripts": {
        "start": "node_modules\\\\electron\\\\dist\\\\electron.exe .",
        "dev": "node_modules\\\\electron\\\\dist\\\\electron.exe . --enable-logging",
        "build": "npx electron-packager . FB-Cookie-Checker --platform=win32 --arch=x64 --out=build --overwrite"
    },
    "dependencies": {
        "adm-zip": "^0.5.10",
        "tesseract.js": "^7.0.0",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "electron": "^28.0.0"
    },
    "allowScripts": {
        "electron@28.3.3": true
    }
}
